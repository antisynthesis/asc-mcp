# Runtime-only image used by the release workflow. The asc-mcp binaries
# are built by the workflow for each target platform and copied in from
# dist/<arch>/; this image does NOT compile Rust itself. For local image
# builds, use Dockerfile.
FROM alpine:3.20

ARG TARGETARCH

RUN apk --no-cache add ca-certificates && \
    adduser -D -g '' -u 10001 appuser

COPY dist/${TARGETARCH}/asc-mcp /usr/local/bin/asc-mcp

USER appuser

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/asc-mcp"]
# Inside a container the server must listen on all interfaces; the
# binary's own default is loopback-only.
CMD ["serve-http", "--addr", "0.0.0.0:8080"]
